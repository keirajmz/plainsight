
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Cámara de PlainSight -->
    <androidx.camera.view.PreviewView
        android:id="@+id/vistaCamara"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Encabezado -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_gravity="top"
        android:background="#CC063957">

        <ImageView
            android:id="@+id/logoSuperior"
            android:layout_width="260dp"
            android:layout_height="80dp"
            android:layout_gravity="center"
            android:src="@drawable/logo_text"
            android:scaleType="fitCenter"
            android:contentDescription="PlainSight" />

    </FrameLayout>

    <!-- Instrucciones -->
    <TextView
        android:id="@+id/mensajeCamara"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#B3000000"
        android:gravity="center"
        android:padding="18dp"
        android:text="Apunta hacia un documento"
        android:textColor="#FFFFFF"
        android:textSize="18sp" />

</FrameLayout>
